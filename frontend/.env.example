# "mock" runs the whole UI on generated demo data (no backend needed).
# "live" talks to the backend squad's REST API.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the REST API (PRD section 9). Same-origin by default.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Poll interval for the dispatcher live board, in milliseconds.
NEXT_PUBLIC_BOARD_POLL_MS=5000

# Phone number shown on the driver Critical screen ("Call dispatch").
NEXT_PUBLIC_DISPATCH_PHONE=
